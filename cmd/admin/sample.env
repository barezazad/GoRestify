# JWT RS256 keys (sign with private, verify with public)
# Generate once:
#   mkdir -p secrets
#   openssl genrsa -out secrets/jwt_private.pem 2048
#   openssl rsa -in secrets/jwt_private.pem -pubout -out secrets/jwt_public.pem
export CORE_JWT_PRIVATE_KEY_PATH="secrets/jwt_private.pem"
export CORE_JWT_PUBLIC_KEY_PATH="secrets/jwt_public.pem"
export CORE_JWT_ACCESS_MINUTES="60"
export CORE_JWT_REFRESH_HOURS="168"

